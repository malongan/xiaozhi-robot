{
    "type": "freenove-esp32s3-display-2.8-lcd",
    "target": "esp32s3",
    "builds": [
        {
            "name": "freenove-esp32s3-display-2.8-lcd",
            "sdkconfig_append": [
                "CONFIG_USE_DEFAULT_MESSAGE_STYLE=y",
                "CONFIG_USE_MULTILINE_CHAT_MESSAGE=y",
                "CONFIG_BT_ENABLED=y",
                "CONFIG_BT_NIMBLE_ENABLED=y",
                "CONFIG_BT_CONTROLLER_ENABLED=y",
                "CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y",
                "CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y",
                "CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y",
                "CONFIG_BT_NIMBLE_SECURITY_ENABLE=y",
                "CONFIG_BT_NIMBLE_SM_SC=y",
                "CONFIG_BT_NIMBLE_SM_LEGACY=y",
                "CONFIG_BT_NIMBLE_NVS_PERSIST=y",
                "CONFIG_BT_NIMBLE_MAX_BONDS=3",
                "CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1",
                "CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y",
                "CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256",
                "CONFIG_FEATURE_WEB_FILE_TRANSFER=y",
                "CONFIG_FEATURE_MUSIC_PLAYER=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m_app6m.csv\"",
                "CONFIG_COMPILER_OPTIMIZATION_PERF=y",
                "CONFIG_LOG_DEFAULT_LEVEL_WARN=y",
                "CONFIG_LWIP_TCP_WND_DEFAULT=11520",
                "CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520"
            ]
        }
    ]
}